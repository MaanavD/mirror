# mirror dashboard server.
#
# Runs on the always-on Tailscale host that serves the display, NOT on the Pi
# (the Pi has no Node). The kiosk and the Pi's backlight controller both point
# at this host, so this unit and those two URLs move together.
#
#   sudo cp systemd/mirror-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now mirror-server
#   journalctl -u mirror-server -f
#
# Adjust User/WorkingDirectory/ExecStart paths to match the checkout.
# Secrets come from the repo's .env (read by dotenv), not from this unit.

[Unit]
Description=mirror smart-mirror dashboard server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maanav
Group=maanav
WorkingDirectory=/home/maanav/mirror
Environment=NODE_ENV=production
Environment=HOME=/home/maanav
ExecStart=/home/maanav/.local/bin/node server.js
Restart=always
RestartSec=3
# Never let a wedged process hold the port forever.
TimeoutStopSec=10
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=mirror

# Modest hardening: the only writable path it needs is the disk cache.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectControlGroups=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
ReadWritePaths=/home/maanav/mirror/data

[Install]
WantedBy=multi-user.target

# mirror — environment
#
# Copy to .env and fill in. .env is gitignored; never commit real secrets.
#   cp .env.example .env
#
# Everything here has a sane default except the secrets, so the server boots
# (degraded) with an empty .env. Modules that are not configured simply report
# themselves as "not configured" instead of erroring forever.


# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Port the dashboard + API listen on. The Pi kiosk points at
# http://<tailnet-host>:8390 — this server does NOT run on the Pi.
PORT=8390


# ---------------------------------------------------------------------------
# Location / time (weather + all date math)
# ---------------------------------------------------------------------------

# Seattle. Used verbatim in the Open-Meteo request.
LAT=47.6062
LON=-122.3321

# IANA timezone. Drives "today"/"tomorrow" boundaries, the 4am quote rotation
# and the display schedule. The clock in the browser uses the Pi's own tz.
TIMEZONE=America/Los_Angeles


# ---------------------------------------------------------------------------
# Google Calendar (v3 REST + refresh-token OAuth; no googleapis SDK)
# ---------------------------------------------------------------------------

# Path to the OAuth client secret JSON downloaded from Google Cloud Console.
# Shape: { "installed": { "client_id": "...", "client_secret": "..." } }
# ("web" instead of "installed" also works.) Relative paths resolve from the
# repo root. Keep these files OUTSIDE the repo or inside secrets/ (gitignored).
GOOGLE_CLIENT_SECRET_FILE=secrets/client_secret.json

# Path to the JSON holding the long-lived refresh token.
# Shape: { "refresh_token": "1//0g..." }  (extra keys are ignored)
GOOGLE_TOKEN_FILE=secrets/token.json

# Comma-separated calendar ids to merge chronologically.
# "primary" works for the account that authorised. Shared//family calendars use
# their ...@group.calendar.google.com id. Empty => calendar module reports
# "not configured" and renders nothing.
GOOGLE_CALENDAR_IDS=primary


# ---------------------------------------------------------------------------
# Notion todos (raw REST; no notion SDK)
# ---------------------------------------------------------------------------

# Internal integration token, starts with "ntn_" (older ones "secret_").
# BLOCKED: the database below is not yet shared with the integration, so this
# module runs as a stub. See SETUP_TODO.md.
NOTION_TOKEN=

# Todo database id (dashes optional).
NOTION_DATABASE_ID=881a49492c1344ccba79ec5cd0d6b939


# ---------------------------------------------------------------------------
# Home Assistant / Nanoleaf Shapes
# ---------------------------------------------------------------------------

# Read-only Home Assistant REST endpoint. The token is read server-side from
# this file at runtime and is never sent to the browser or written to logs.
HA_URL=http://100.97.0.104:8123
HA_TOKEN_FILE=/home/hermes/.hermes/ha_token


# ---------------------------------------------------------------------------
# Quote
# ---------------------------------------------------------------------------

# ZenQuotes endpoint to use: "today" (one quote per day, what we want) or
# "random". Rotation happens server-side at 04:00 local, not per page refresh.
# API down => local hard-work fallback list. The dashboard always shows the
# required (very dim) "inspired by ZenQuotes" credit.
ZENQUOTES_MODE=today


# ---------------------------------------------------------------------------
# Spotify now-playing (refresh-token OAuth)
# ---------------------------------------------------------------------------

# Values from the Spotify developer app and the long-lived user refresh token.
# The redirect URI is retained for the one-time authorization setup; polling
# uses the refresh token and does not expose these values to the browser.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
SPOTIFY_REFRESH_TOKEN=


# ---------------------------------------------------------------------------
# Display power (server <-> thin Pi agent)
# ---------------------------------------------------------------------------

# Shared secret for POST /api/display/on and /api/display/off on THIS server.
#   Authorization: Bearer <DISPLAY_TOKEN>
# Generate: openssl rand -hex 32
# Empty => those endpoints return 503 (fail closed), except in MOCK=1.
DISPLAY_TOKEN=

# Base URL of the pi-agent running on the Pi (see pi-agent/). Empty => the
# server only flips its own soft state (frontend fades to pure black, which on
# a two-way mirror is indistinguishable from "off").
PI_AGENT_URL=http://pi.tailnet:8420

# Bearer token the pi-agent expects. Must match PI_AGENT_TOKEN in
# pi-agent's own environment. Generate: openssl rand -hex 32
PI_AGENT_TOKEN=

# Scheduled fallback blackout, local 24h HH:MM. The real "on" trigger is
# external (Eight Sleep webhook -> curl POST /api/display/on).
DISPLAY_OFF_TIME=00:30

# Optional scheduled wake, local 24h HH:MM. Empty => no scheduled on.
DISPLAY_ON_TIME=


# ---------------------------------------------------------------------------
# Dev
# ---------------------------------------------------------------------------

# 1 => every module serves realistic mock data, no network, no secrets needed.
# `npm run dev` sets this for you. /preview gives a scaled 1080x1920 frame.
MOCK=0
